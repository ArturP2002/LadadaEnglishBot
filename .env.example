BOT_TOKEN=your_bot_token_here
CHANNEL_ID=

# PostgreSQL — вариант 1: полный URL
# DATABASE_URL=postgresql://ladada:password@localhost:5432/ladada_bot

# PostgreSQL — вариант 2: отдельные параметры (если DATABASE_URL не задан)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ladada
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=ladada_bot

# AmoCRM
ACCESS_TOKEN=
SECRET_KEY=
CRM_ID=
AMO_BASE_URL=
AMO_SUBDOMAIN=

# Google Sheets (опционально)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json
GOOGLE_SHEETS_WORKSHEET=Заявки

# Т‑Банк интернет-эквайринг
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
TBANK_NOTIFICATION_URL=https://your-domain.example/tbank/notification
TBANK_SUCCESS_URL=https://your-domain.example/success
TBANK_FAIL_URL=https://your-domain.example/fail
TBANK_SSL_VERIFY=true

# HTTP webhook (локально за nginx)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Прокси только для api.telegram.org (оставьте пустым, если не нужен)
TELEGRAM_PROXY_URL=
